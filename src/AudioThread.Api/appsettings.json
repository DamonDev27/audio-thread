{
  "AudioUpload": {
    "MaxFileSizeInBytes": 52428800,
    "AllowedExtensions": [ ".mp3", ".wav" ],
    "AllowedContentTypes": [
      "audio/mpeg",
      "audio/mp3",
      "audio/wav",
      "audio/wave",
      "audio/x-wav"
    ]
  },
  "AudioCompression": {
    "ExecutablePath": "ffmpeg",
    "AudioBitrate": "128k",
    "TimeoutSeconds": 120
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:4173" ]
  },
  "AudioProcessing": {
    "ExecutionMode": "Optimized",
    "MaxConcurrentJobs": 2,
    "QueueCapacity": 8
  },
  "AudioSummarization": {
    "PythonExecutablePath": "python/.venv/bin/python",
    "ScriptPath": "python/summarize_audio.py",
    "SpeechToTextModel": "tiny",
    "SummarizationModel": "Qwen/Qwen2.5-1.5B-Instruct",
    "ComputeType": "int8",
    "TorchDataType": "bfloat16",
    "MaxSummaryLength": 150,
    "ModelThreads": 4,
    "TimeoutSeconds": 600,
    "ModelCacheDirectory": "model-cache"
  },
  "AudioNoiseReduction": {
    "PythonExecutablePath": "python/.venv/bin/python",
    "ScriptPath": "python/enhance_audio.py",
    "Model": "DeepFilterNet3",
    "ModelCacheDirectory": "model-cache",
    "ModelThreads": 2,
    "TimeoutSeconds": 600,
    "EnablePostFilter": true
  },
  "Supabase": {
    "Url": "",
    "ServiceRoleKey": "",
    "StorageBucket": "audio-files",
    "UsePublicUrls": false
  },
  "ConnectionStrings": {
    "AudioThreadDatabase": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
